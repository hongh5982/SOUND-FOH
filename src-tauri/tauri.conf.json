{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SFOH",
  "version": "0.1.0",
  "identifier": "com.sfoh.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "S'FOH",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#000000",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["Korean", "English"]
      }
    }
  }
}
